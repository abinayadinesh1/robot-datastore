[Unit]
Description=Frame Bucket API
After=network.target

[Service]
Type=simple
User=abinaya
WorkingDirectory=/home/abinaya/robot-datastore/frame-bucket
ExecStart=/bin/bash -c 'source /home/abinaya/robot-datastore/frame-bucket/.env && exec /home/abinaya/robot-datastore/frame-bucket/target/release/frame-bucket-api'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
